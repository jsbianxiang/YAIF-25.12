# =========================================================
# YAIF-25.12 NanoPi R2S Long Term Maintenance Base
#
# ImmortalWrt 25.12.1
#
# Target:
#   FriendlyARM NanoPi R2S
#
# CPU:
#   Rockchip RK3328 ARM64
#
# Proxy:
#   Nikki + Mihomo Meta
#
# Backup:
#   Daed
#
# Kernel:
#   Linux 6.12
#   eBPF + BTF Ready
#
# Package:
#   APK
#
# =========================================================


# =========================================================
# 1. Target Architecture
# =========================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y


# =========================================================
# 2. Firmware Layout
# =========================================================

CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=8192

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y

CONFIG_TARGET_IMAGES_GZIP=y


# =========================================================
# 3. Package Manager
# =========================================================

CONFIG_USE_APK=y


# =========================================================
# 4. Kernel BPF / BTF / dae / daed Support
# =========================================================


# ---- BPF Core ----

CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y


# ---- BTF Debug Information ----

CONFIG_KERNEL_DEBUG_INFO=y

# Disable debug reduction
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set

CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y

CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y


# ---- Host BTF Generator ----

CONFIG_DWARVES=y


# ---- eBPF Runtime ----

CONFIG_KERNEL_CGROUPS=y

CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y

CONFIG_KERNEL_BPF_EVENTS=y


# ---- TC BPF ----

CONFIG_KERNEL_NET_SCHED=y

CONFIG_KERNEL_NET_CLS_BPF=y
CONFIG_KERNEL_NET_CLS_ACT=y

CONFIG_KERNEL_NET_SCH_INGRESS=y


# ---- Advanced Network Hook ----

CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_XDP_SOCKETS=y


# ---- Performance ----

CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

# CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE is not set



# =========================================================
# 5. Global Network
# =========================================================

CONFIG_IPV6=y


# =========================================================
# 6. LuCI
# =========================================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y


# =========================================================
# 7. Base Network
# =========================================================

CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y


CONFIG_PACKAGE_firewall4=y

CONFIG_DEFAULT_nftables=y

CONFIG_PACKAGE_nftables-json=y



# =========================================================
# 8. Nikki + Mihomo Meta
# =========================================================

CONFIG_PACKAGE_nikki=y

CONFIG_PACKAGE_mihomo-meta=y

CONFIG_PACKAGE_luci-app-nikki=y

CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y


# Disable old Mihomo package

# CONFIG_PACKAGE_mihomo-alpha is not set



# =========================================================
# 9. Runtime Tools
# =========================================================

CONFIG_PACKAGE_ca-bundle=y

CONFIG_PACKAGE_curl=y

CONFIG_PACKAGE_yq=y

CONFIG_PACKAGE_ip-full=y

CONFIG_PACKAGE_resolveip=y



# =========================================================
# 10. Transparent Proxy
# =========================================================

CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_kmod-dummy=y


CONFIG_PACKAGE_kmod-inet-diag=y


# nft proxy

CONFIG_PACKAGE_kmod-nft-core=y

CONFIG_PACKAGE_kmod-nft-socket=y

CONFIG_PACKAGE_kmod-nft-tproxy=y

CONFIG_PACKAGE_kmod-nft-nat=y

CONFIG_PACKAGE_kmod-nft-fullcone=y


# conntrack

CONFIG_PACKAGE_kmod-nf-conntrack=y

CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y


# NAT helper

CONFIG_PACKAGE_kmod-nf-nathelper=y

CONFIG_PACKAGE_kmod-nf-nathelper-extra=y



# =========================================================
# 11. Daed Backup Proxy
# =========================================================

CONFIG_PACKAGE_daed=y

CONFIG_PACKAGE_luci-app-daed=y

CONFIG_PACKAGE_daed-geoip=y

CONFIG_PACKAGE_daed-geosite=y


CONFIG_DAED_USE_KERNEL_BTF=y


# =========================================================
# 12. BPF Tools
# =========================================================

CONFIG_PACKAGE_bpftool=y


# =========================================================
# 13. Network Performance
# =========================================================

CONFIG_PACKAGE_kmod-nft-offload=y



# =========================================================
# 14. IPv6
#
# Telecom IPv6 PD
#
# =========================================================

CONFIG_PACKAGE_ipv6helper=y


# =========================================================
# 15. LuCI Applications
# =========================================================

CONFIG_PACKAGE_luci-app-firewall=y

CONFIG_PACKAGE_luci-app-ddns=y

CONFIG_PACKAGE_luci-app-adguardhome=y



# =========================================================
# 16. AdGuardHome
# =========================================================

CONFIG_PACKAGE_adguardhome=y



# =========================================================
# 17. Diagnostics
# =========================================================

CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_tcpdump=y

CONFIG_PACKAGE_bind-dig=y

CONFIG_PACKAGE_mtr=y

CONFIG_PACKAGE_ethtool=y

CONFIG_PACKAGE_iperf3=y

CONFIG_PACKAGE_conntrack=y



# =========================================================
# 18. USB Storage
#
# NanoPi R2S External SSD / U Disk
#
# =========================================================

CONFIG_PACKAGE_kmod-usb-core=y

CONFIG_PACKAGE_kmod-usb2=y

CONFIG_PACKAGE_kmod-usb3=y


CONFIG_PACKAGE_kmod-usb-storage=y


# SCSI support

CONFIG_PACKAGE_kmod-scsi-core=y

CONFIG_PACKAGE_kmod-scsi-generic=y


# Filesystem

CONFIG_PACKAGE_block-mount=y

CONFIG_PACKAGE_kmod-fs-ext4=y

CONFIG_PACKAGE_kmod-fs-vfat=y

CONFIG_PACKAGE_kmod-fuse=y


CONFIG_PACKAGE_usbutils=y



# =========================================================
# 19. Network Device
# =========================================================

CONFIG_PACKAGE_kmod-bridge=y



# =========================================================
# 20. SSH / Remote Management
# =========================================================

CONFIG_PACKAGE_dropbear=y

CONFIG_PACKAGE_openssh-sftp-server=y



# =========================================================
# 21. Time Service
# =========================================================

CONFIG_PACKAGE_ntp-utils=y



# =========================================================
# 22-1. TCP Performance & BBR 拥塞控制
# =========================================================
CONFIG_KERNEL_TCP_CONG_BBR=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_KERNEL_DEFAULT_TCP_CONG="bbr"

# =========================================================
# 22-2. Queueing Discipline (qdisc)
# =========================================================
# FQ：内建，确保 qdisc 可用
CONFIG_KERNEL_NET_SCH_FQ=y

# 基础调度器模块，包含 fq_codel 等
CONFIG_PACKAGE_kmod-sched-core=y

# CAKE：保留，便于后续手动测试 Bufferbloat
CONFIG_PACKAGE_kmod-sched-cake=y

# =========================================================
# 22-3. Network Tools
# =========================================================
# tc 命令行工具
CONFIG_PACKAGE_tc-tiny=y