# =========================================================
# YAIF-25.12 NanoPi R2S Long Term Base Configuration
#
# ImmortalWrt 25.12
# Target: FriendlyARM NanoPi R2S
# CPU: Rockchip RK3328 ARM64
#
# Main proxy:
#   Nikki + Mihomo Meta
#
# Backup:
#   Daed
#
# Kernel:
#   eBPF + BTF ready
# =========================================================


# =========================================================
# 1. Target 平台
# =========================================================

CONFIG_TARGET_rockchip=y

CONFIG_TARGET_rockchip_armv8=y

CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y



# =========================================================
# 2. 固件格式
# =========================================================

# SquashFS 默认 OpenWrt 固件
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 保留 ext4 镜像能力
CONFIG_TARGET_ROOTFS_EXT4FS=y



# =========================================================
# 3. LuCI Web 管理
# =========================================================

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_luci-ssl=y



# =========================================================
# 4. 基础网络服务
# =========================================================

# DNS/DHCP
CONFIG_PACKAGE_dnsmasq-full=y

# IPv6 DHCP Client
CONFIG_PACKAGE_odhcp6c=y

# IPv6 RA/DHCPv6 Server
CONFIG_PACKAGE_odhcpd-ipv6only=y


# Firewall4 nftables
CONFIG_PACKAGE_firewall4=y

CONFIG_PACKAGE_nftables=y



# =========================================================
# 5. Nikki + Mihomo Meta
#
# 注意：
# mihomo-alpha 与 mihomo-meta 不允许同时启用
#
# 本方案固定：
# mihomo-meta 稳定版
# =========================================================

CONFIG_PACKAGE_nikki=y

CONFIG_PACKAGE_mihomo-meta=y


# 禁止：
# CONFIG_PACKAGE_mihomo-alpha=y



# =========================================================
# 6. Daed 备用
#
# 用于测试和未来切换
#
# 不与 Nikki 同时运行 TUN
# =========================================================

CONFIG_PACKAGE_daed=y

CONFIG_PACKAGE_luci-app-daed=y


# =========================================================
# 7. dae 关闭
#
# 当前主方案不是 dae
# 避免多个代理核心维护
# =========================================================

# CONFIG_PACKAGE_dae is not set

# CONFIG_PACKAGE_luci-app-dae is not set



# =========================================================
# 8. eBPF / BTF 内核支持
#
# dae/daed 需要
#
# 用于：
# - BPF 程序加载
# - 内核符号解析
# =========================================================

CONFIG_KERNEL_DEBUG_INFO=y

CONFIG_KERNEL_DEBUG_INFO_BTF=y


# daed 使用 kernel BTF
CONFIG_DAED_USE_KERNEL_BTF=y



# =========================================================
# 9. 网络性能
# =========================================================

# Conntrack
CONFIG_PACKAGE_kmod-nf-conntrack=y


# nft flow offload
CONFIG_PACKAGE_kmod-nft-offload=y


# LuCI 流量卸载管理
CONFIG_PACKAGE_luci-app-offloading=y



# =========================================================
# 10. LuCI 常用应用
# =========================================================

# 防火墙管理
CONFIG_PACKAGE_luci-app-firewall=y


# DDNS
CONFIG_PACKAGE_luci-app-ddns=y


# AdGuardHome 管理
CONFIG_PACKAGE_luci-app-adguardhome=y


# 注意：
# ImmortalWrt 25.12 使用 apk
# 不使用：
# CONFIG_PACKAGE_luci-app-opkg=y



# =========================================================
# 11. 网络诊断工具
# =========================================================

# ip 命令完整版
CONFIG_PACKAGE_ip-full=y


# curl
CONFIG_PACKAGE_curl=y


# wget HTTPS
CONFIG_PACKAGE_wget-ssl=y


# 抓包
CONFIG_PACKAGE_tcpdump=y


# DNS 查询
CONFIG_PACKAGE_bind-dig=y


# 网络质量测试
CONFIG_PACKAGE_mtr=y


# 网卡状态
CONFIG_PACKAGE_ethtool=y



# =========================================================
# 12. USB 存储支持
#
# R2S 外接存储
# =========================================================

CONFIG_PACKAGE_kmod-usb-core=y

CONFIG_PACKAGE_kmod-usb2=y

CONFIG_PACKAGE_kmod-usb-storage=y

CONFIG_PACKAGE_block-mount=y



# =========================================================
# 13. R2S 网络相关
#
# 使用内核默认 Rockchip GMAC
#
# 不强制加入 r8169
# =========================================================

CONFIG_PACKAGE_kmod-bridge=y



# =========================================================
# 14. 清理旧配置
#
# 防止旧版本污染
# =========================================================


# mihomo alpha 测试版关闭   
# CONFIG_PACKAGE_mihomo-alpha is not set


# dae 关闭
# CONFIG_PACKAGE_dae is not set


# luci dae关闭
# CONFIG_PACKAGE_luci-app-dae is not set


# opkg时代组件关闭
# CONFIG_PACKAGE_luci-app-opkg is not set