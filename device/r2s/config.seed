# =========================================================
# YAIF-25.12 NanoPi R2S Long Term Maintenance Base
#
# 基础系统：
#   ImmortalWrt 25.12.1
#
# 上游基线：
#   OpenWrt 25.12
#
# 硬件：
#   FriendlyARM NanoPi R2S
#   Rockchip RK3328
#   ARM64 / aarch64
#
# 软件包管理器：
#   APK
#
# 代理架构：
#   主代理：Nikki + Mihomo Meta
#   备用代理：Daed
#
# 内核：
#   Linux 6.12
#   BPF / BTF / CO-RE
#
# =========================================================
# 配置优先级
# =========================================================
#
#   1. ImmortalWrt 25.12.1 官方 R2S / 官方软件包
#   2. YAIF 核心配置
#   3. YAOF 可选增强
#
# 发生冲突时：
#   高优先级配置优先。
#
# 人工筛选规则：
#
#   CONFIG_xxx=y
#       明确要求启用 / 安装。
#
#   CONFIG_xxx=n
#       明确要求禁用 / 不安装。
#
#   # CONFIG_xxx is not set
#       明确要求禁用 / 不安装。
#
# 注意：
#   普通“不需要”的软件不主动写入禁用项，
#   由 Kconfig / package dependency 决定。
#
#   但涉及构建行为、BPF/BTF、TLS backend、
#   优化方式等功能性配置的禁用语法必须保留。
#
# =========================================================


# =========================================================
# 1. Target Architecture
# =========================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y


# =========================================================
# 2. Firmware Layout
# =========================================================
#
# 内核分区：
#   64 MB
#
# RootFS 分区：
#   1024 MB
#
# 同时生成 SquashFS 与 ext4 根文件系统。
# =========================================================

CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y

CONFIG_TARGET_IMAGES_GZIP=y


# =========================================================
# 3. APK / Build Environment
# =========================================================

CONFIG_USE_APK=y

# 保留完整 kernel module 构建能力。
# 便于后续使用匹配的官方 R2S kmod 软件源按需安装。
CONFIG_ALL_KMODS=y

# 保留开发及工具链配置能力。
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y


# =========================================================
# 4. Build / Debug Information
# =========================================================

# 不因 warning 直接导致 kernel build 失败。
# CONFIG_KERNEL_WERROR is not set

CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"

# 收集 kernel / module 调试符号。
CONFIG_COLLECT_KERNEL_DEBUG=y

# 使用可复现调试信息。
CONFIG_REPRODUCIBLE_DEBUG_INFO=y


# =========================================================
# 5. Toolchain / Compression
# =========================================================

# Zlib 优先性能。
CONFIG_ZLIB_OPTIMIZE_SPEED=y


# =========================================================
# 6. Global Network
# =========================================================

# 启用 IPv6。
CONFIG_IPV6=y


# =========================================================
# 7. ImmortalWrt 25.12.1 Official / R2S Base
# =========================================================

CONFIG_PACKAGE_apk-openssl=y

CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_block-mount=y

# TLS 根证书。
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ImmortalWrt 中文发行版默认设置。
CONFIG_PACKAGE_default-settings-chn=y

# 完整版 dnsmasq。
CONFIG_PACKAGE_dnsmasq-full=y

# SSH。
CONFIG_PACKAGE_dropbear=y

# 磁盘 / 分区工具。
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y

# 防火墙。
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y

# libc / libgcc。
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y

# OpenSSL ustream。
CONFIG_PACKAGE_libustream-openssl=y

# 系统日志。
CONFIG_PACKAGE_logd=y

# LuCI。
CONFIG_PACKAGE_luci=y

# MTD。
CONFIG_PACKAGE_mtd=y

# 网络管理。
CONFIG_PACKAGE_netifd=y

# nftables JSON。
CONFIG_PACKAGE_nftables-json=y

# DHCPv6 / IPv6 RA。
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# PPP / PPPoE。
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# procd jail。
CONFIG_PACKAGE_procd-ujail=y

# U-Boot 环境变量。
CONFIG_PACKAGE_uboot-envtools=y

# UCI。
CONFIG_PACKAGE_uci=y

# uclient-fetch。
CONFIG_PACKAGE_uclient-fetch=y

# 官方 R2S 基线随机数支持。
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y


# =========================================================
# 8. R2S Network Hardware
# =========================================================

# RTL8152 USB 网卡。
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# RTL8152 固件。
CONFIG_PACKAGE_r8152-firmware=y

# RK3328 Trusted Firmware-A。
CONFIG_PACKAGE_trusted-firmware-a-rk3328=y


# =========================================================
# 9. R2S Hardware / Platform
# =========================================================

# ARM 平台 autocore。
CONFIG_PACKAGE_autocore-arm=y

# PWM 风扇控制。
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y


# =========================================================
# 10. LuCI Official Base
# =========================================================

# LuCI HTTPS。
CONFIG_PACKAGE_luci-ssl=y

# CPU 频率管理。
CONFIG_PACKAGE_luci-app-cpufreq=y

# 防火墙管理。
CONFIG_PACKAGE_luci-app-firewall=y

# APK 软件包管理器。
CONFIG_PACKAGE_luci-app-package-manager=y

# 官方 Bootstrap 主题。
CONFIG_PACKAGE_luci-theme-bootstrap=y

# LuCI 兼容层。
CONFIG_PACKAGE_luci-compat=y


# =========================================================
# 11. LuCI Languages
# =========================================================

CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y

# 不启用 CSS tidy。
# CONFIG_LUCI_CSSTIDY is not set

# 不启用 JS 压缩器。
# CONFIG_LUCI_JSMIN is not set


# =========================================================
# 12. LuCI Chinese / Firmware Generator Entry
# =========================================================
#
# 中文翻译包作为明确的 LuCI 中文界面入口。
#
# 通过 package dependency 自动拉取对应主应用及依赖。
# =========================================================

# LuCI 基础中文。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# CPUFreq 中文。
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# Firewall 中文。
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# APK Package Manager 中文。
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# Argon 配置器及中文。
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# Daed 中文。
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# Filebrowser 中文。
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y

# Ramfree 中文入口。
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y

# Tailscale Community 中文入口。
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# ttyd 中文入口。
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# UPnP 中文。
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# VLMCSd 中文入口。
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y


# =========================================================
# 13. Attended Sysupgrade
# =========================================================
#
# 本固件采用自维护编译与升级流程，不使用 ASU。
# =========================================================

# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn is not set


# =========================================================
# 14. DNS
# =========================================================

# dnsmasq-full IPSet 支持。
CONFIG_PACKAGE_dnsmasq_full_ipset=y


# =========================================================
# 15. IPv6
# =========================================================
#
# IPv6 内核能力由 CONFIG_IPV6=y 提供。
#
# 不使用不存在于当前官方 25.12.1 / Nikki 来源模型中的
# ipv6helper package。
# =========================================================


# =========================================================
# 16. Firewall / nftables Compatibility
# =========================================================

# Legacy firewall 禁用。
# CONFIG_PACKAGE_firewall is not set

# ARP → nft。
CONFIG_PACKAGE_arptables-nft=y
# CONFIG_PACKAGE_arptables-legacy is not set

# ebtables → nft。
CONFIG_PACKAGE_ebtables-nft=y
# CONFIG_PACKAGE_ebtables-legacy is not set

# ip6tables → nft。
CONFIG_PACKAGE_ip6tables-nft=y
# CONFIG_PACKAGE_ip6tables-legacy is not set

# xtables → nft。
CONFIG_PACKAGE_xtables-nft=y
# CONFIG_PACKAGE_xtables-legacy is not set

# iptables → nft。
CONFIG_PACKAGE_iptables-nft=y
# CONFIG_PACKAGE_iptables-legacy is not set

# iptables 兼容模块。
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y


# =========================================================
# 17. nft Flow Offload
# =========================================================
#
# 保留官方 nft Flow Offload 能力。
#
# 运行时是否启用：
#   flow_offloading
#   flow_offloading_hw
#
# 由 firewall4 配置决定，不由本 seed 决定。
# =========================================================

CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y


# =========================================================
# 18. Transparent Proxy / TUN / TProxy / FullCone
# =========================================================

# TUN。
CONFIG_PACKAGE_kmod-tun=y

# Dummy interface。
CONFIG_PACKAGE_kmod-dummy=y

# 网络连接诊断。
CONFIG_PACKAGE_kmod-inet-diag=y

# nft socket。
CONFIG_PACKAGE_kmod-nft-socket=y

# nft TProxy。
CONFIG_PACKAGE_kmod-nft-tproxy=y

# conntrack。
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

# NAT。
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y

# nft NAT。
CONFIG_PACKAGE_kmod-nft-nat=y

# FullCone NAT。
CONFIG_PACKAGE_kmod-nft-fullcone=y


# =========================================================
# 19. UPnP / NAT
# =========================================================

CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

# Legacy iptables miniupnpd 不使用。
# CONFIG_PACKAGE_miniupnpd-iptables is not set


# =========================================================
# 20. Nikki + Mihomo Meta
#
# 主代理。
# =========================================================

CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_mihomo-meta=y

CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y


# =========================================================
# 21. Daed
#
# 备用代理。
# =========================================================

CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# Daed Geo 数据。
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y

# Daed 使用内核 BTF。
CONFIG_DAED_USE_KERNEL_BTF=y


# =========================================================
# 22. BPF / BTF / eBPF / CO-RE
# =========================================================
#
# 用途：
#   eBPF
#   BTF
#   CO-RE
#   Daed 内核 BTF
#   内核 / 网络调试
# =========================================================

# Host 端 BPF toolchain。
CONFIG_BPF_TOOLCHAIN_HOST=y


# -------------------------
# BPF Core
# -------------------------

CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y


# -------------------------
# Debug Information / BTF
# -------------------------

CONFIG_KERNEL_DEBUG_INFO=y

# 不减少调试信息。
#
# 保证需要完整 debug information 的工具具有可用数据。
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set

CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y

# 允许模块 BTF 信息存在 mismatch 时继续加载。
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y


# -------------------------
# BTF Generator
# -------------------------

CONFIG_DWARVES=y


# -------------------------
# eBPF Runtime
# -------------------------

CONFIG_KERNEL_CGROUPS=y

CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y

CONFIG_KERNEL_BPF_EVENTS=y


# -------------------------
# TC BPF
# -------------------------

CONFIG_KERNEL_NET_SCHED=y
CONFIG_KERNEL_NET_CLS_BPF=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_NET_SCH_INGRESS=y


# -------------------------
# Advanced BPF
# -------------------------

CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_XDP_SOCKETS=y


# -------------------------
# BPF Diagnostics
# -------------------------

CONFIG_PACKAGE_bpftool=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y


# =========================================================
# 23. Kernel Debugging
# =========================================================
#
# 保留轻量级调试能力。
# =========================================================

CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PERF_EVENTS=y


# =========================================================
# 24. Kernel Performance
# =========================================================

# 优先性能。
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 不使用 size 优化。
# CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE is not set


# =========================================================
# 25. BBR
# =========================================================
#
# 已经过实际测试确认有效。
# =========================================================

CONFIG_PACKAGE_kmod-tcp-bbr=y


# =========================================================
# 26. ZRAM
#
# YAOF 可选增强。
# =========================================================

CONFIG_PACKAGE_zram-swap=y

CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-zstd=y


# =========================================================
# 27. Network Device / Bridge
# =========================================================

CONFIG_PACKAGE_kmod-bridge=y


# =========================================================
# 28. WireGuard
# =========================================================

CONFIG_PACKAGE_luci-proto-wireguard=y


# =========================================================
# 29. DDNS
# =========================================================

CONFIG_PACKAGE_luci-app-ddns=y

CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y


# =========================================================
# 30. FRP
# =========================================================

# FRPC 客户端。
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y


# =========================================================
# 31. ZeroTier
# =========================================================

CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y


# =========================================================
# 32. CPU / System Management
# =========================================================

CONFIG_PACKAGE_luci-app-watchcat=y


# =========================================================
# 33. USB Storage
# =========================================================
#
# 用途：
#   TF/SD：
#     系统 / 低频写入
#
#   USB SSD / U盘：
#     高频数据 / 外部存储
# =========================================================

# USB 控制器。
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# USB 存储。
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# SCSI。
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y


# 文件系统。
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# FUSE。
CONFIG_PACKAGE_kmod-fuse=y


# 自动挂载。
CONFIG_PACKAGE_automount=y


# 存储维护工具。
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_ntfs3-mount=y

# USB 设备工具。
CONFIG_PACKAGE_usbutils=y


# =========================================================
# 34. USB Network / Mobile Device Support
# =========================================================

# iPhone / iPad 以及相关 USB 设备支持。
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y

# Android / 手机 USB 网络共享。
CONFIG_PACKAGE_kmod-usb-net-rndis=y


# =========================================================
# 35. HTTPS / TLS / Configuration Tools
# =========================================================

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y

# libcurl 使用 OpenSSL。
CONFIG_LIBCURL_OPENSSL=y

# 明确排除其他 TLS backend。
# CONFIG_LIBCURL_MBEDTLS is not set
# CONFIG_LIBCURL_WOLFSSL is not set
# CONFIG_LIBCURL_GNUTLS is not set
# CONFIG_LIBCURL_NOSSL is not set

# HTTPS wget。
CONFIG_PACKAGE_wget-ssl=y

# YAML 配置处理工具。
CONFIG_PACKAGE_yq=y


# =========================================================
# 36. OpenSSL
# =========================================================

# OpenSSL Engine。
CONFIG_OPENSSL_ENGINE=y

# 优先性能。
CONFIG_OPENSSL_OPTIMIZE_SPEED=y

# ARM64 汇编优化。
CONFIG_OPENSSL_WITH_ASM=y

# 保留错误信息，方便调试。
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y

# OpenSSL 配置。
CONFIG_PACKAGE_libopenssl-conf=y

# Legacy Provider。
CONFIG_PACKAGE_libopenssl-legacy=y

# 当前设计不需要 devcrypto。
# CONFIG_PACKAGE_libopenssl-devcrypto is not set


# =========================================================
# 37. Crypto Kernel Modules
#
# 官方 R2S 25.12.1 成品中的基础 crypto 模块。
# =========================================================

CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-arc4=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha3=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-user=y


# =========================================================
# 38. DNS / IP Diagnostics
# =========================================================

CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_resolveip=y


# =========================================================
# 39. Network Diagnostics
# =========================================================

# 网络抓包。
CONFIG_PACKAGE_tcpdump=y

# 路由 / 网络质量诊断。
CONFIG_PACKAGE_mtr=y

# 吞吐测试。
CONFIG_PACKAGE_iperf3=y

# conntrack 调试。
CONFIG_PACKAGE_conntrack=y

# 网卡 / PHY 诊断。
CONFIG_PACKAGE_ethtool=y


# =========================================================
# 40. Process / System Diagnostics
# =========================================================

CONFIG_PACKAGE_htop=y


# =========================================================
# 41. SSH / Remote Management
# =========================================================

CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=y


# =========================================================
# 42. Time Service
# =========================================================

CONFIG_PACKAGE_ntp-utils=y


# =========================================================
# 43. Additional Maintenance / Diagnostics
# =========================================================

# 二维码生成工具。
CONFIG_PACKAGE_qrencode=y