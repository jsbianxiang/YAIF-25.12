# =========================================================

# YAIF-25.12 NanoPi R2S Long Term Maintenance Base

#

# 基础系统：

# ImmortalWrt 25.12.1

#

# 上游基线：

# OpenWrt 25.12

#

# 硬件：

# FriendlyARM NanoPi R2S

# Rockchip RK3328

# ARM64 / aarch64

#

# 软件包管理器：

# APK

#

# 代理架构：

# 主代理：Nikki + Mihomo Meta（由 Nikki feed / dependency 决定）

# 备用代理：Daed

#

# 内核：

# Linux 6.12.x

# BPF / BTF / CO-RE

#

# 配置来源与处理原则
#
# 1. ImmortalWrt 25.12.1 官方 Target / Device Profile / Packages
# 2. Nikki feed 提供的扩展软件包
# 3. 本 seed 的显式功能选择
#
# 最终配置由 Kconfig / package dependency / select / depends
# 综合计算生成。
#
# 本 seed 仅对需要明确控制的功能进行人工声明。
# 自动依赖项不重复人工展开。
# =========================================================

# =========================================================

# 1. Target / Device Profile

# =========================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y

# =========================================================

# 2. Firmware Layout

# =========================================================

#

# 内核分区：

# 64 MB

#

# RootFS 分区容量上限：

# 1024 MB

#

# 同时生成 SquashFS 与 ext4 根文件系统。

# =========================================================

CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# =========================================================

# 3. APK / Build Environment

# =========================================================

CONFIG_USE_APK=y

# 保留完整 kernel module 构建能力。

# 便于后续使用匹配的官方 R2S kmod 软件源按需安装。

CONFIG_ALL_KMODS=y

# 保留开发及工具链配置能力。

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y

# =========================================================

# 4. Build / Debug Information

# =========================================================

# 不因 warning 直接导致 kernel build 失败。

# CONFIG_KERNEL_WERROR is not set

CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"

# 收集 kernel / module 调试符号。

CONFIG_COLLECT_KERNEL_DEBUG=y

# 使用可复现调试信息。

CONFIG_REPRODUCIBLE_DEBUG_INFO=y

# =========================================================

# 5. Toolchain / Compression

# =========================================================

# Zlib 优先性能。

CONFIG_ZLIB_OPTIMIZE_SPEED=y

# =========================================================

# 6. Global Network

# =========================================================

# 启用 IPv6。

CONFIG_IPV6=y

# =========================================================

# 7. Official Base System

# =========================================================

CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_block-mount=y

# TLS 根证书。

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ImmortalWrt 中文发行版默认设置。

CONFIG_PACKAGE_default-settings-chn=y

# 完整版 dnsmasq。

CONFIG_PACKAGE_dnsmasq-full=y

# fstools

CONFIG_PACKAGE_fstools=y

# libc / libgcc。

CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y

# OpenSSL ustream。

CONFIG_PACKAGE_libustream-openssl=y

# 系统日志。

CONFIG_PACKAGE_logd=y

# LuCI。

CONFIG_PACKAGE_luci=y

# MTD。

CONFIG_PACKAGE_mtd=y

# 网络管理。

CONFIG_PACKAGE_netifd=y

# DHCPv6 / IPv6 RA。

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# PPP / PPPoE。

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# procd jail。

CONFIG_PACKAGE_procd-ujail=y

# U-Boot 环境变量。

CONFIG_PACKAGE_uboot-envtools=y

# UCI。

CONFIG_PACKAGE_uci=y

# uclient-fetch。

CONFIG_PACKAGE_uclient-fetch=y

# 官方 R2S 基线随机数支持。

CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# =========================================================

# 8. R2S Hardware / Platform

# =========================================================

# R2S USB 网卡支持。
#
# Device Profile / package dependency
# 负责相应 RTL8152/RTL8153 驱动。
# 本处显式预装对应 firmware。

CONFIG_PACKAGE_r8152-firmware=y

# ARM 平台 autocore。

CONFIG_PACKAGE_autocore=y

# RK3328 Trusted Firmware-A。

CONFIG_PACKAGE_trusted-firmware-a-rk3328=y

# PWM 风扇控制。

CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# =========================================================

# 9. User-selected Software

#

# 本区域只放需要主动预装/启用的软件包。

#

# 后续新增 / 删除软件时，优先只修改本区域。

#

# 合法来源：

# - ImmortalWrt 25.12.1 官方软件包 / R2S kmod

# - Nikki feed

# =========================================================

# ---------------------------------------------------------

# LuCI Base / Compatibility / Theme

# ---------------------------------------------------------

# LuCI SSL

CONFIG_PACKAGE_luci-ssl=y

# Theme Argon

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# Theme Bootstrap
CONFIG_PACKAGE_luci-theme-bootstrap=y

# LuCI Base / Compatibility
CONFIG_PACKAGE_luci-compat=y

# ---------------------------------------------------------

# LuCI Applications / Chinese

# ---------------------------------------------------------

CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# Filebrowser。

CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y

# Ramfree。

CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-i18n-ramfree-zh-cn=y

# Tailscale Community。

CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# ttyd。

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# UPnP。

CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# VLMCSd。

CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y

# LuCI 基础中文。

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------------------------------------------------------
# Proxy
# ---------------------------------------------------------

# 主代理：Nikki + Mihomo Meta。
#
# mihomo-alpha 不属于本固件代理架构。
# 由 Workflow forbidden policy 强制禁止，
# 避免与 Mihomo Meta / Nikki 架构产生冲突。
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# 备用代理：Daed。
# Daed 自身依赖 v2ray-geoip / v2ray-geosite，
# 由 package dependency 自动解决。
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_luci-app-daed=y
CONFIG_PACKAGE_luci-i18n-daed-zh-cn=y

# GeoData 由 Daed package dependency 处理。
#
# 不在 seed 中单独指定：
#   daed-geoip
#   daed-geosite
#   v2ray-geoip
#   v2ray-geosite

# ---------------------------------------------------------

# Network / VPN / Overlay

# ---------------------------------------------------------

CONFIG_PACKAGE_luci-proto-wireguard=y

# DDNS

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-dnspod=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-aliyun=y

# FRPC 客户端。

CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y

# ZeroTier。

CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# Watchcat。

CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y

# ---------------------------------------------------------

# DNS / Diagnostics

# ---------------------------------------------------------

# dnsmasq-full IPSet 支持。

CONFIG_PACKAGE_dnsmasq_full_ipset=y

# DNS 查询 / 解析诊断。

CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_resolveip=y

# ---------------------------------------------------------

# Diagnostics / Utilities

# ---------------------------------------------------------

CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ntp-utils=y
CONFIG_PACKAGE_qrencode=y

# ---------------------------------------------------------

# HTTPS / TLS / Configuration Tools

# ---------------------------------------------------------

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_yq=y

# ---------------------------------------------------------

# OpenSSL packages

# ---------------------------------------------------------

CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-legacy=y

# 当前设计不需要 devcrypto。

# CONFIG_PACKAGE_libopenssl-devcrypto is not set

# =========================================================

# 10. Firewall / nftables / NAT

# =========================================================

# ---------------------------------------------------------

# Firewall4 Core

# ---------------------------------------------------------

CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y

# Legacy firewall 禁用。

# CONFIG_PACKAGE_firewall is not set

# ---------------------------------------------------------

# Nikki TUN / TProxy Core

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ---------------------------------------------------------

# IPv6 / Connection Tracking

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# ---------------------------------------------------------

# FullCone NAT

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-nft-fullcone=y

# ---------------------------------------------------------

# Flow Offload

#

# 编译保留；运行时是否启用由 firewall4 配置决定。

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-nft-offload=y

# ---------------------------------------------------------

# nftables-backed Compatibility

#

# 非 Nikki 核心依赖。

# 为第三方软件、旧脚本及兼容性保留。

# ---------------------------------------------------------

CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_arptables-nft=y
CONFIG_PACKAGE_ebtables-nft=y

# Legacy backend explicitly disabled。

# CONFIG_PACKAGE_arptables-legacy is not set

# CONFIG_PACKAGE_ebtables-legacy is not set

# CONFIG_PACKAGE_ip6tables-legacy is not set

# CONFIG_PACKAGE_xtables-legacy is not set

# CONFIG_PACKAGE_iptables-legacy is not set

# ---------------------------------------------------------

# iptables Compatibility Extensions

# ---------------------------------------------------------

CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

# ---------------------------------------------------------

# UPnP backend

# ---------------------------------------------------------

CONFIG_PACKAGE_miniupnpd-nftables=y

# Legacy iptables miniupnpd 不使用。

# CONFIG_PACKAGE_miniupnpd-iptables is not set

# =========================================================

# 11. BPF / BTF / eBPF / CO-RE

# =========================================================

#

# 用途：

# eBPF

# BPF tracing

# BPF stream parser

# BTF

# CO-RE

# XDP / AF_XDP

# Netkit

# 内核 / 网络调试

#

# 说明：

# 以 ImmortalWrt 25.12.1 实际 R2S / Rockchip ARMv8

# build configuration 及当前 Kconfig 为准。

# 由 Kconfig 自动派生的子项不重复人工指定。

# =========================================================

# Host BPF toolchain。

CONFIG_BPF_TOOLCHAIN_HOST=y

# BTF Generator / pahole。

CONFIG_DWARVES=y

# BPF / tracing。

CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y

# cgroup BPF 基础能力。

CONFIG_KERNEL_CGROUPS=y

# Kprobe / tracing。

CONFIG_KERNEL_KPROBES=y

# XDP / Netkit。

CONFIG_KERNEL_NETKIT=y
CONFIG_KERNEL_XDP_SOCKETS=y

# Debug Information / BTF。

CONFIG_KERNEL_DEBUG_INFO=y

# 不减少调试信息。

# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set

CONFIG_KERNEL_DEBUG_INFO_BTF=y

# 允许模块 BTF mismatch 时继续加载。

CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y

# BPF / XDP diagnostics。

CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# TC BPF。

CONFIG_PACKAGE_kmod-sched-bpf=y

# 注意：

# 以下项目不在 seed 中重复人工指定，

# 由当前 Kconfig 自动派生：

#

# CONFIG_KERNEL_CGROUP_BPF

# CONFIG_KERNEL_KPROBE_EVENTS

# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES

# =========================================================

# 12. Kernel Debugging

# =========================================================

CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PERF_EVENTS=y

# =========================================================

# 13. Kernel Performance

# =========================================================

# 优先性能。

CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 不使用 size 优化。

# CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE is not set

# =========================================================

# 14. BBR

# =========================================================

CONFIG_PACKAGE_kmod-tcp-bbr=y

# =========================================================

# 15. ZRAM

# =========================================================

CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# =========================================================

# 16. USB / Storage / Filesystem

# =========================================================

# ---------------------------------------------------------

# USB Host

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# ---------------------------------------------------------

# USB Mass Storage / UAS

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ---------------------------------------------------------

# SCSI

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y

# ---------------------------------------------------------

# Filesystems

# ---------------------------------------------------------

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fuse=y

# ---------------------------------------------------------

# Storage Management

# ---------------------------------------------------------

CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_usbutils=y

# =========================================================

# 17. USB Mobile / Network

# =========================================================

CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# =========================================================

# 18. Crypto Kernel Modules

# =========================================================

#

# 仅保留人工选择的 Crypto 根包。

# 其它由 package dependency 自动带入：

#

# crypto-hash

# crypto-hmac

# crypto-manager

# crypto-aead

# crypto-null

# crypto-sha3

# crypto-sha512

#

# =========================================================

CONFIG_PACKAGE_kmod-crypto-arc4=y
CONFIG_PACKAGE_kmod-crypto-crc32c=y
CONFIG_PACKAGE_kmod-crypto-ecb=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-user=y

# =========================================================

# 19. LuCI Languages / Build Features

# =========================================================

CONFIG_LUCI_LANG_zh_Hans=y

# 不启用 CSS tidy。

# CONFIG_LUCI_CSSTIDY is not set

# 不启用 JS 压缩器。

# CONFIG_LUCI_JSMIN is not set

# =========================================================

# 20. Attended Sysupgrade

# =========================================================

#

# 本固件采用自维护编译与升级流程，不使用 ASU。

# =========================================================

# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set

# CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn is not set
