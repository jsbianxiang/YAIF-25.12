# =========================================================
# YAIF-25.12 NanoPi R2S Long Term Maintenance Base
#
# ImmortalWrt 25.12.1
#
# Target:
#   FriendlyARM NanoPi R2S
#
# CPU:
#   Rockchip RK3328 ARM64
#
# Main Proxy:
#   Nikki + Mihomo Meta
#
# Backup:
#   Daed
#
# Kernel:
#   Linux 6.12
#   eBPF + BTF Ready
#
# Package:
#   APK
#
# =========================================================



# =========================================================
# 1. Target
# =========================================================


CONFIG_TARGET_rockchip=y

CONFIG_TARGET_rockchip_armv8=y

CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y



# =========================================================
# 2. Firmware Layout
# =========================================================


CONFIG_TARGET_ROOTFS_SQUASHFS=y

CONFIG_TARGET_ROOTFS_EXT4FS=y


CONFIG_TARGET_KERNEL_PARTSIZE=64

CONFIG_TARGET_ROOTFS_PARTSIZE=4096




# =========================================================
# 3. LuCI
# =========================================================


CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_luci-ssl=y




# =========================================================
# 4. Base Network
# =========================================================


CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_odhcp6c=y

CONFIG_PACKAGE_odhcpd-ipv6only=y


CONFIG_PACKAGE_firewall4=y

CONFIG_PACKAGE_nftables=y




# =========================================================
# 5. Nikki + Mihomo Meta
# =========================================================


CONFIG_PACKAGE_nikki=y

CONFIG_PACKAGE_mihomo-meta=y


CONFIG_PACKAGE_luci-app-nikki=y

CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y



# Runtime


CONFIG_PACKAGE_ca-bundle=y

CONFIG_PACKAGE_curl=y

CONFIG_PACKAGE_yq=y

CONFIG_PACKAGE_ip-full=y




# =========================================================
# 6. Transparent Proxy
# =========================================================


CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_kmod-dummy=y


CONFIG_PACKAGE_kmod-inet-diag=y


CONFIG_PACKAGE_kmod-nft-core=y

CONFIG_PACKAGE_kmod-nft-socket=y

CONFIG_PACKAGE_kmod-nft-tproxy=y

CONFIG_PACKAGE_kmod-nft-nat=y

CONFIG_PACKAGE_kmod-nft-fullcone=y


CONFIG_PACKAGE_kmod-nf-conntrack=y

CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y




# =========================================================
# 7. Daed Backup Proxy
# =========================================================


CONFIG_PACKAGE_daed=y

CONFIG_PACKAGE_luci-app-daed=y


CONFIG_PACKAGE_daed-geoip=y

CONFIG_PACKAGE_daed-geosite=y




# =========================================================
# 8. Disable Old Proxy
#
# Real disable
#
# =========================================================


# CONFIG_PACKAGE_mihomo-alpha is not set




# =========================================================
# 9. Kernel Debug / BTF / eBPF
#
# Linux 6.12
#
# dae / daed Kernel BTF Ready
#
# =========================================================


# Kernel debug information

CONFIG_KERNEL_DEBUG_INFO=y


# 禁止裁剪 Debug 信息
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set



# Kernel BTF
#
# Generate:
#   /sys/kernel/btf/vmlinux
#

CONFIG_KERNEL_DEBUG_INFO_BTF=y



# Module BTF
#
# Keep for advanced eBPF debugging
#
# Generate:
#   /sys/kernel/btf/*.ko
#

CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES=y





# =========================================================
# eBPF Core
# =========================================================


CONFIG_KERNEL_BPF=y

CONFIG_KERNEL_BPF_SYSCALL=y

CONFIG_KERNEL_BPF_JIT=y



# =========================================================
# dae recommended kernel features
#
# Keep explicit to avoid kernel config drift
#
# =========================================================


CONFIG_KERNEL_CGROUPS=y

CONFIG_KERNEL_KPROBES=y

CONFIG_KERNEL_KPROBE_EVENTS=y

CONFIG_KERNEL_BPF_EVENTS=y


CONFIG_KERNEL_NET_SCHED=y

CONFIG_KERNEL_NET_CLS_BPF=y

CONFIG_KERNEL_NET_CLS_ACT=y

CONFIG_KERNEL_NET_SCH_INGRESS=y





# =========================================================
# Kernel config export
#
# Debug / maintenance
#
# =========================================================


CONFIG_KERNEL_IKCONFIG=y
CONFIG_KERNEL_IKCONFIG_PROC=y





# =========================================================
# Daed Kernel BTF
# =========================================================


CONFIG_DAED_USE_KERNEL_BTF=y





# =========================================================
# BPF tools
# =========================================================


CONFIG_PACKAGE_bpftool=y


# =========================================================
# 10. Network Performance
# =========================================================


CONFIG_PACKAGE_kmod-nft-offload=y




# =========================================================
# 11. IPv6
#
# Telecom IPv6 PD
#
# =========================================================


CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_ip6tables-nft=y


CONFIG_PACKAGE_kmod-ip6-tunnel=y

CONFIG_PACKAGE_kmod-sit=y




# =========================================================
# 12. LuCI Applications
# =========================================================


CONFIG_PACKAGE_luci-app-firewall=y

CONFIG_PACKAGE_luci-app-ddns=y

CONFIG_PACKAGE_luci-app-adguardhome=y




# =========================================================
# 13. AdGuardHome
# =========================================================


CONFIG_PACKAGE_adguardhome=y




# =========================================================
# 14. Diagnostics
# =========================================================


CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_tcpdump=y

CONFIG_PACKAGE_bind-dig=y

CONFIG_PACKAGE_mtr=y

CONFIG_PACKAGE_ethtool=y

CONFIG_PACKAGE_iperf3=y

CONFIG_PACKAGE_conntrack=y




# =========================================================
# 15. USB Storage
#
# R2S external SSD/U disk
#
# =========================================================


CONFIG_PACKAGE_kmod-usb-core=y

CONFIG_PACKAGE_kmod-usb2=y

CONFIG_PACKAGE_kmod-usb3=y


CONFIG_PACKAGE_kmod-usb-storage=y


CONFIG_PACKAGE_block-mount=y


CONFIG_PACKAGE_kmod-fs-ext4=y

CONFIG_PACKAGE_kmod-fs-vfat=y

CONFIG_PACKAGE_kmod-fuse=y


CONFIG_PACKAGE_usbutils=y




# =========================================================
# 16. Network Device
# =========================================================


CONFIG_PACKAGE_kmod-bridge=y




# =========================================================
# 17. SSH / Remote Management
# =========================================================


CONFIG_PACKAGE_dropbear=y

CONFIG_PACKAGE_openssh-sftp-server=y



# 不启用 LuCI 文件管理器
# CONFIG_PACKAGE_luci-app-filetransfer is not set




# =========================================================
# 18. APK Package Manager
# =========================================================


CONFIG_USE_APK=y


# Disable OPKG
# CONFIG_PACKAGE_opkg is not set




# =========================================================
# 19. Time
# =========================================================


CONFIG_PACKAGE_ntp-utils=y


