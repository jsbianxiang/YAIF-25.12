# =========================================================
# YAIF-25.12 NanoPi R2S Long Term Maintenance Base
#
# ImmortalWrt 25.12
# Target:
#   FriendlyARM NanoPi R2S
#
# CPU:
#   Rockchip RK3328 ARM64
#
# Main Proxy:
#   Nikki + Mihomo Meta
#
# Backup:
#   Daed
#
# Kernel:
#   eBPF + BTF Ready
#
# Partition:
#   Kernel 64MB
#   Rootfs 4096MB
# =========================================================



# =========================================================
# 1. Target 平台
# =========================================================

CONFIG_TARGET_rockchip=y

CONFIG_TARGET_rockchip_armv8=y

CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r2s=y



# =========================================================
# 2. 固件格式与分区
# =========================================================


# SquashFS 固件
CONFIG_TARGET_ROOTFS_SQUASHFS=y


# 保留 ext4 镜像能力
CONFIG_TARGET_ROOTFS_EXT4FS=y


# Kernel 分区大小
# 单位 MB
CONFIG_TARGET_KERNEL_PARTSIZE=64


# Rootfs 分区大小
# 单位 MB
# 约 4GB 软件空间
CONFIG_TARGET_ROOTFS_PARTSIZE=4096




# =========================================================
# 3. LuCI Web 管理
# =========================================================


CONFIG_PACKAGE_luci=y


# HTTPS 管理
CONFIG_PACKAGE_luci-ssl=y




# =========================================================
# 4. 基础网络
# =========================================================


# dnsmasq 完整版
CONFIG_PACKAGE_dnsmasq-full=y


# IPv6 DHCP Client
CONFIG_PACKAGE_odhcp6c=y


# IPv6 RA/DHCPv6 Server
CONFIG_PACKAGE_odhcpd-ipv6only=y


# firewall4 nftables
CONFIG_PACKAGE_firewall4=y


# nftables 工具
CONFIG_PACKAGE_nftables=y




# =========================================================
# 5. Nikki + Mihomo Meta
#
# 主代理方案
#
# 注意：
# mihomo-alpha 与 mihomo-meta 禁止同时启用
# =========================================================


CONFIG_PACKAGE_nikki=y


CONFIG_PACKAGE_luci-app-nikki=y


# Mihomo Meta 稳定核心
CONFIG_PACKAGE_mihomo-meta=y


# 禁止测试核心
# CONFIG_PACKAGE_mihomo-alpha is not set





# =========================================================
# 6. Daed 备用代理
#
# 保留用于测试
#
# 不与 Nikki 同时运行
# =========================================================


CONFIG_PACKAGE_daed=y

CONFIG_PACKAGE_luci-app-daed=y





# =========================================================
# 7. dae 关闭
#
# 避免多个代理核心维护
# =========================================================


# CONFIG_PACKAGE_dae is not set

# CONFIG_PACKAGE_luci-app-dae is not set





# =========================================================
# 8. Kernel eBPF / BTF
#
# Daed / dae 需要
# =========================================================


CONFIG_KERNEL_DEBUG_INFO=y


# 禁止裁剪 Debug 信息
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set


CONFIG_KERNEL_DEBUG_INFO_BTF=y


# Daed 使用 Kernel BTF
CONFIG_DAED_USE_KERNEL_BTF=y





# =========================================================
# 9. 网络性能优化
# =========================================================


# Conntrack
CONFIG_PACKAGE_kmod-nf-conntrack=y


# nft flow offload
CONFIG_PACKAGE_kmod-nft-offload=y




# =========================================================
# 10. LuCI 常用组件
# =========================================================


# 防火墙管理
CONFIG_PACKAGE_luci-app-firewall=y


# DDNS
CONFIG_PACKAGE_luci-app-ddns=y


# AdGuardHome LuCI
CONFIG_PACKAGE_luci-app-adguardhome=y





# =========================================================
# 11. 网络诊断工具
# =========================================================


# ip-full
CONFIG_PACKAGE_ip-full=y


# curl
CONFIG_PACKAGE_curl=y


# wget HTTPS
CONFIG_PACKAGE_wget-ssl=y


# 抓包
CONFIG_PACKAGE_tcpdump=y


# DNS 查询
CONFIG_PACKAGE_bind-dig=y


# 网络质量测试
CONFIG_PACKAGE_mtr=y


# 网卡工具
CONFIG_PACKAGE_ethtool=y





# =========================================================
# 12. USB 存储
#
# R2S 外接 SSD/U盘
# =========================================================


CONFIG_PACKAGE_kmod-usb-core=y


CONFIG_PACKAGE_kmod-usb2=y


CONFIG_PACKAGE_kmod-usb3=y


CONFIG_PACKAGE_kmod-usb-storage=y


CONFIG_PACKAGE_block-mount=y





# =========================================================
# 13. 网络设备
#
# Rockchip GMAC
# 使用内核默认驱动
# 不加入 r8169
# =========================================================


CONFIG_PACKAGE_kmod-bridge=y





# =========================================================
# 14. 清理旧版本配置
#
# ImmortalWrt 25.12 APK
# 不使用 opkg
# =========================================================


# 禁止 mihomo-alpha
# CONFIG_PACKAGE_mihomo-alpha is not set


# 禁止 dae
# CONFIG_PACKAGE_dae is not set


# 禁止 luci-app-dae
# CONFIG_PACKAGE_luci-app-dae is not set


# 禁止旧 opkg 管理
# CONFIG_PACKAGE_luci-app-opkg is not set