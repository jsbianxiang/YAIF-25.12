# =========================================================
# YAIF-25.12 行尾规范化
#
# 背景：
#   Windows 客户端 core.autocrlf=true 会把检出文件写成 CRLF，
#   而 GitHub Actions (ubuntu-24.04) 上直接执行这些脚本。
#
#   CRLF 会导致：
#     - Shell 脚本 shebang 后的 \r 被当作命令一部分
#     - config.seed 被 cp 成 .config 后解析异常
#     - uci-defaults 在路由器上执行失败
#
# 策略：
#   仓库内统一存 LF，检出时也强制 LF，不做 CRLF 转换。
#   （OpenWrt 生态全部为 LF，不兼容 CRLF）
# =========================================================

# 默认：自动检测文本文件，不转换
* text=auto

# ---------------------------------------------------------
# Shell 脚本：强制 LF
# ---------------------------------------------------------

*.sh      text eol=lf
*.bash    text eol=lf

# ---------------------------------------------------------
# uci-defaults / init.d 脚本：强制 LF
#
# 注意：模式中的路径是相对仓库根目录的。
# YAIF 仓库中这些文件位于 files/ 下，需带 files/ 前缀。
# 同时保留不带前缀的写法，以兼容将来目录调整。
# ---------------------------------------------------------

files/etc/uci-defaults/*  text eol=lf
files/etc/init.d/*        text eol=lf
/etc/uci-defaults/*       text eol=lf
/etc/init.d/*             text eol=lf

# YAIF files/ 下的全部文件（脚本/配置）强制 LF
files/**                  text eol=lf

# ---------------------------------------------------------
# 构建配置：强制 LF
# ---------------------------------------------------------

*.seed    text eol=lf
*.old     text eol=lf
*.config  text eol=lf
*.list    text eol=lf
*.conf    text eol=lf

# ---------------------------------------------------------
# 文档与配置
# ---------------------------------------------------------

*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
*.json    text eol=lf

# .gitattributes / LICENSE 自身也固定 LF，避免自引用抖动
.gitattributes  text eol=lf
LICENSE         text eol=lf

# ---------------------------------------------------------
# 二进制：不做任何转换
# ---------------------------------------------------------

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.gz      binary
*.xz      binary
*.zst     binary
*.zip     binary
*.apk     binary
*.ipk     binary
*.bin     binary
*.itb     binary
*.dtb     binary
