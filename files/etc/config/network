# =========================================================
# ImmortalWrt 官方原生网口定义 (NanoPi R2S)
# eth0 : 原生板载网口 (WAN 口)
# eth1 : USB 扩展网口 (LAN 口)
# =========================================================

# ---------------------------------------------------------
# 1. 本地环回接口 (Loopback)
# ---------------------------------------------------------
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

# ---------------------------------------------------------
# 2. 全局网络参数配置
# ---------------------------------------------------------
config globals 'globals'

# ---------------------------------------------------------
# 3. LAN 局域网桥接设备 (绑定 eth1 USB 网口)
# ---------------------------------------------------------
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'

# ---------------------------------------------------------
# 4. LAN 接口配置 (后台管理网段: 192.168.2.1/24)
# ---------------------------------------------------------
config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.2.1/24'
	option ip6assign '64'
	option delegate '0'
	option ip6ifaceid 'eui64'

# ---------------------------------------------------------
# 5. WAN 广域网接口配置 (绑定 eth0 原生网口，接入上级光猫/主路由)
# ---------------------------------------------------------
config interface 'wan'
	option device 'eth0'
	option proto 'static'
	list ipaddr '192.168.1.2/24'
	option gateway '192.168.1.1'
	option broadcast '192.168.1.255'
	list dns '223.5.5.5'
	list dns '119.29.29.29'

# ---------------------------------------------------------
# 6. WAN6 IPv6 接口配置
# ---------------------------------------------------------
config interface 'wan6'
	option device 'eth0'
	option proto 'dhcpv6'
	option norelease '1'
	option peerdns '0'