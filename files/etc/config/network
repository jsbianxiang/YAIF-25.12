# =========================================================
# YAIF-25.12 R2S Network Configuration
#
# Device:
#   NanoPi R2S
#
# Default Mode:
#   Secondary Router Mode
#
# Port Definition:
#   eth0 : Native onboard Ethernet (WAN)
#   eth1 : USB Ethernet adapter (LAN)
#
# Network Role:
#   - R2S provides LAN gateway
#   - IPv4 NAT forwarding
#   - IPv6 prefix delegation
#   - Mihomo TUN proxy gateway
# =========================================================


# ---------------------------------------------------------
# 1. 本地环回接口 (Loopback)
#
# 系统内部通信接口
# ---------------------------------------------------------

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'


# ---------------------------------------------------------
# 2. 全局网络参数配置
#
# packet steering:
#   开启多核数据包处理
#
# steering flows:
#   设置流量分配数量
# ---------------------------------------------------------

config globals 'globals'
	option packet_steering '1'
	option steering_flows '128'


# ---------------------------------------------------------
# 3. LAN 局域网桥接设备
#
# eth1:
#   USB 扩展网口
#
# 用于连接:
#   - 下级交换机
#   - 家庭终端设备
# ---------------------------------------------------------

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'


# ---------------------------------------------------------
# 4. LAN 局域网接口配置
#
# 管理地址:
#   192.168.2.1/24
#
# DHCP:
#   由 R2S 提供
#
# IPv6:
#   从 WAN6 获取前缀后分配 /64
# ---------------------------------------------------------

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.2.1/24'
	option ip6assign '64'
	option delegate '0'
	option ip6ifaceid 'eui64'
	option multipath 'off'


# ---------------------------------------------------------
# 5. WAN 广域网接口配置
#
# eth0:
#   原生板载网口
#
# 上联设备:
#   光猫 / 主路由
#
# 当前模式:
#   静态 IPv4 上联
#
# IPv4:
#   R2S WAN:
#       192.168.1.2
#
#   Gateway:
#       192.168.1.1
#
# DNS:
#   使用固定国内 DNS
#   防止运营商 DNS 注入
#
# 该 DNS 作为基础网络备用解析。
# 正常运行时 DNS 由 Mihomo TUN 接管。
# ---------------------------------------------------------

config interface 'wan'
	option device 'eth0'
	option proto 'static'
	list ipaddr '192.168.1.2/24'
	option gateway '192.168.1.1'
	option broadcast '192.168.1.255'
	list dns '119.29.29.29'
	option multipath 'off'


# ---------------------------------------------------------
# 6. WAN6 IPv6 接口配置
#
# IPv6 获取方式:
#   DHCPv6 Prefix Delegation
#
# 作用:
#   - 从上级网络获取 IPv6 前缀
#   - 向 LAN 分配 IPv6 地址
#
# DNS:
#   不接受上级 IPv6 DNS
#
# 原因:
#   - 避免运营商 DNS 注入
#   - DNS控制由 Mihomo TUN 完成
#
# IPv6 与 IPv4 共用 eth0 出口。
# ---------------------------------------------------------

config interface 'wan6'
	option device 'eth0'
	option proto 'dhcpv6'
	option norelease '1'
	option peerdns '0'
	option reqaddress 'try'
	option reqprefix 'auto'
	option multipath 'off'