#!/bin/sh

# =========================================================
# YAIF R2S ImmortalWrt 25.12
# Nikki / Clashoo Mihomo 内核模式适配
#
# 适用于：
# R2S + ImmortalWrt 25.12
# Mihomo TUN 透明代理
#
# 设计原则：
# 1. 保留官方 IPv6 工作方式
# 2. DNS 交给 Mihomo 接管
# 3. 禁止流量卸载避免绕过代理
# 4. 针对 R2S 性能进行优化
# =========================================================


echo "===== YAIF R2S Fix Start ====="



# =========================================================
# 0. 修改前备份配置
# =========================================================

BK="/root/yaif-adapt-backup-$(date +%Y%m%d-%H%M%S)"

mkdir -p "$BK"


cp -a /etc/config/dhcp "$BK/dhcp" 2>/dev/null
cp -a /etc/config/firewall "$BK/firewall" 2>/dev/null
cp -a /etc/config/network "$BK/network" 2>/dev/null
cp -a /etc/apk/repositories.d/distfeeds.list "$BK/distfeeds.list" 2>/dev/null


echo "备份目录:"
echo "$BK"



# =========================================================
# 1. 修正 ImmortalWrt 25.12 APK 软件源
# =========================================================


REPO="/etc/apk/repositories.d/distfeeds.list"


if [ -f "$REPO" ]; then


    # 替换默认镜像源
    # 方便国内网络访问

    sed -i \
    -e 's#mirrors.vsean.net/immortalwrt#mirrors.ustc.edu.cn/immortalwrt#g' \
    -e 's#mirrors.vsean.net/openwrt#mirrors.ustc.edu.cn/immortalwrt#g' \
    "$REPO"



    # 删除无实际用途的视频 feed
    # R2S 无需保留

    sed -i \
    -e '/video.*packages\.adb/d' \
    "$REPO"



    if grep -q "mirrors.ustc.edu.cn" "$REPO"; then

        echo "软件源：已切换到 USTC"

    else

        echo "软件源：请检查 distfeeds.list"

    fi


else

    echo "未找到 APK 软件源配置"

fi




# =========================================================
# 2. dnsmasq 设置
#
# 目标：
# DNS 解析交由 Mihomo TUN 接管
# 避免 dnsmasq 二次过滤
# =========================================================



# 删除 DNS 重定向配置
# 防止与 Mihomo DNS hijack 冲突

uci -q del dhcp.@dnsmasq[0].dns_redirect



# 不监听通配符地址
# 只监听实际配置接口

uci -q del dhcp.@dnsmasq[0].nonwildcard



# 删除 dnsmasq DNS 过滤功能
# 由 Mihomo 规则系统处理

uci -q del dhcp.@dnsmasq[0].boguspriv
uci -q del dhcp.@dnsmasq[0].filterwin2k
uci -q del dhcp.@dnsmasq[0].filter_aaaa
uci -q del dhcp.@dnsmasq[0].filter_a





# =========================================================
# 3. 防火墙设置
#
# 目标：
# 保证 Mihomo TUN 透明代理完整接管流量
# =========================================================



# 关闭 SYN Flood 防护
# 减少低性能设备额外处理

uci -q del firewall.@defaults[0].syn_flood




# 关闭 FullCone NAT
# 保持 nftables 默认 NAT 行为

uci -q del firewall.@defaults[0].fullcone
uci -q del firewall.@defaults[0].fullcone6




# 关闭软件流量卸载
# 避免绕过 nftables 和 Mihomo TUN

uci -q del firewall.@defaults[0].flow_offloading
uci -q del firewall.@defaults[0].flow_offloading_hw




# 防火墙区域设置  区域  wan拒绝主动转发

uci set firewall.@zone[1].forward='REJECT'





# =========================================================
# 4. LAN 网络设置
# =========================================================



# 设置 LAN IPv4 地址

uci -q del network.lan.ipaddr

uci add_list network.lan.ipaddr='192.168.2.1/24'



# 单 WAN 环境关闭 multipath

uci set network.lan.multipath='off'



# LAN IPv6 恢复 ImmortalWrt 默认行为
# 删除显式配置，让系统使用默认值

uci -q del dhcp.lan.ra_slaac
uci -q del dhcp.lan.dhcpv6
uci set dhcp.lan.ra_preference='medium'




# =========================================================
# 5. WAN 设置
# =========================================================



# 保持 DHCP Client ID 默认行为

uci set network.wan.sendclientid='auto'


# 单线路关闭 multipath

uci set network.wan.multipath='off'





# =========================================================
# 6. WAN6 IPv6 设置
# =========================================================
#
# 适用于：
# 电信 IPv6 DHCPv6-PD
#
# 保持前缀稳定
# =========================================================



uci set network.wan6.reqaddress='try'

uci set network.wan6.reqprefix='auto'


# 不主动释放 IPv6 前缀

uci set network.wan6.norelease='1'


uci set network.wan6.sendclientid='auto'


uci set network.wan6.multipath='off'





# =========================================================
# 7. 保存配置
# =========================================================


uci commit dhcp

uci commit firewall

uci commit network




echo

echo "===== YAIF Fix Complete ====="

echo

echo "备份目录:"
echo "$BK"

echo

echo "建议重启:"
echo "reboot"


exit 0
