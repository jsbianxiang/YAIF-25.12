#!/bin/sh

# =========================================================
# YAIF R2S 25.12 首次启动修正
#
# 适用：
#   ImmortalWrt 25.12.x
#
# 作用：
#   1. 修正 ImmortalWrt APK 官方软件源
#   2. 删除当前无实际内容的 video feed
#   3. 清理 dnsmasq 显式 DNS 干预配置
#   4. 禁用 Firewall 流量卸载
#   5. 开启 FullCone NAT
#   6. 关闭 SYN Flood Protection
#   7. 保留 Invalid Conntrack 默认处理
#   8. 清理 IPv6 ULA 默认前缀
#   9. 开启 Packet Steering
#  10. 设置 R2S LAN IPv4 / IPv6 参数
#  11. 设置家庭 IPv6 RA / SLAAC 参数
#  12. 固定 WAN DNS，禁止 ISP DNS 自动下发
#
# 设计原则：
#   - DNS 由 Mihomo 统一接管
#   - dnsmasq 仅承担基础 DHCP / RA 服务
#   - R2S 不启用流量卸载，避免影响代理透明转发
#   - IPv6 使用运营商提供的 LAN /64 前缀
#   - LAN 采用 RA + SLAAC，不进行 IPv6 前缀继续委派
#
# 重要：
#   本脚本不依赖 cfg01xxxx 等匿名 UCI section ID。
#   不修改 ZeroTier 配置。
#   不重启 network / firewall，避免首次启动过程中断网络。
# =========================================================


# =========================================================
# 1. 修正 ImmortalWrt APK 官方软件源
# =========================================================

REPO="/etc/apk/repositories.d/distfeeds.list"

if [ -f "$REPO" ]; then

    sed -i \
        -e 's#mirrors.vsean.net/immortalwrt#mirrors.ustc.edu.cn/immortalwrt#g' \
        -e 's#mirrors.vsean.net/openwrt#mirrors.ustc.edu.cn/immortalwrt#g' \
        "$REPO"

    # 删除当前无实际内容的 video feed
    sed -i \
        -e '/video.*packages\.adb/d' \
        "$REPO"

fi


# =========================================================
# 2. DNS / dnsmasq
# =========================================================
#
# DNS 由 Mihomo 统一处理。
#
# 清理：
#   DNS 重定向
#   DNS 过滤
#   默认缓存限制
#   系统 resolv.conf 跟随行为
#
# 删除后由 dnsmasq 默认逻辑运行。
# Mihomo 负责最终 DNS 解析策略。
# =========================================================

uci -q delete dhcp.@dnsmasq[0].dns_redirect
uci -q delete dhcp.@dnsmasq[0].nonwildcard
uci -q delete dhcp.@dnsmasq[0].boguspriv
uci -q delete dhcp.@dnsmasq[0].filterwin2k
uci -q delete dhcp.@dnsmasq[0].filter_aaaa
uci -q delete dhcp.@dnsmasq[0].filter_a
uci -q delete dhcp.@dnsmasq[0].max_cache_ttl
uci -q delete dhcp.@dnsmasq[0].min_cache_ttl
uci -q delete dhcp.@dnsmasq[0].cachesize
uci -q delete dhcp.@dnsmasq[0].noresolv

# =========================================================
# 3. LAN IPv6 RA / DHCPv6
# =========================================================
#
# 家用 IPv6：
#   RA = Server
#   SLAAC = 不单独指定
#   DHCPv6 = 不启用
#   RA Flags = none
#   DNS Service = 关闭
#
# IPv6 地址：
#   由运营商提供的公网 IPv6 /64 前缀生成。
#
# 网络模型：
#   WAN6 获取 IPv6
#        |
#        v
#   LAN RA 广播
#        |
#        v
#   终端 SLAAC 自动配置
#
# 不进行 IPv6 前缀继续委派。
# =========================================================

uci -q delete dhcp.lan.ra_slaac
uci -q delete dhcp.lan.dhcpv6

uci set dhcp.lan.ra_preference='high'

uci -q delete dhcp.lan.ra_flags
uci add_list dhcp.lan.ra_flags='none'

uci set dhcp.lan.dns_service='0'


# =========================================================
# 4. Firewall
# =========================================================
#
# R2S 不使用：
#   Flow Offloading
#   Hardware Flow Offloading
#
# 保留：
#   FullCone NAT
#
# 禁用：
#   Flow Offloading
#   Hardware Flow Offloading
#   SYN Flood Protection
#
# 不启用：
#   Invalid Conntrack 丢弃
#
# 目的：
#   降低 R2S 防火墙额外处理，
#   保持 Mihomo 透明代理链路稳定。
# =========================================================

uci -q delete firewall.@defaults[0].syn_flood
uci -q delete firewall.@defaults[0].fullcone6
uci -q delete firewall.@defaults[0].flow_offloading
uci -q delete firewall.@defaults[0].flow_offloading_hw

uci set firewall.@defaults[0].drop_invalid='0'
uci set firewall.@defaults[0].synflood_protect='0'
uci set firewall.@defaults[0].fullcone='1'


# =========================================================
# 5. Network Globals
# =========================================================

# 删除默认 ULA 前缀
uci -q delete network.globals.ula_prefix

# 开启 Packet Steering
uci set network.globals.packet_steering='1'


# =========================================================
# 6. LAN IPv4 / IPv6
# =========================================================

uci -q delete network.lan.ipaddr
uci add_list network.lan.ipaddr='192.168.2.1/24'

uci set network.lan.multipath='off'
uci set network.lan.delegate='0'
uci set network.lan.ip6assign='64'
uci set network.lan.ip6ifaceid='eui64'


# =========================================================
# 7. WAN / WAN6 DNS
# =========================================================
#
# WAN：
#   禁止 ISP 自动下发 DNS
#   仅使用指定 IPv4 DNS
#
# WAN6：
#   禁止 ISP 通过 DHCPv6 下发 DNS
#
# 先删除旧 DNS，再重新添加，避免脚本重复执行
# 时产生重复 DNS 条目。
# =========================================================

uci -q delete network.wan.dns
uci add_list network.wan.dns='119.29.29.29'

uci set network.wan.peerdns='0'
uci set network.wan6.peerdns='0'


# =========================================================
# 8. 保存配置
# =========================================================

uci commit dhcp
uci commit firewall
uci commit network


# =========================================================
# 完成
# =========================================================

exit 0
