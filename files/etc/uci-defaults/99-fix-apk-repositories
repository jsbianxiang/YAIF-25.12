echo "       nft list ruleset | grep -i 'maxseg size'"
echo "       -> 期望看到 'tcp option maxseg size set 1452'"
echo "       -> 若显示 1460，说明 device MTU 没生效，回到第 1) 条"
echo "  4) wan.dns 必须写成 list："
echo "       uci show network.wan.dns"
echo "       -> 应为  '223.5.5.5' '119.29.29.29'   两个独立引号"
echo "  5) interface 段不应再有 mtu："
echo "       uci show network.wan; uci show network.lan | grep -i mtu"
echo "  6) LAN 地址与 IPv6 前缀："
